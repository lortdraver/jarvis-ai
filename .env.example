# --- Мозг: порядок провайдеров (первый рабочий отвечает) ---
JARVIS_AI_PROVIDERS=ollama,gemini
OLLAMA_MODEL=qwen3:8b
# Бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Необязательно (если добавить groq в JARVIS_AI_PROVIDERS)
GROQ_API_KEY=
JARVIS_GROQ_MODEL=llama-3.3-70b-versatile

# --- Голос (послушать варианты: python voice_test.py) ---
JARVIS_VOICE=ru-RU-DmitryNeural
JARVIS_TTS_RATE=-5%
JARVIS_TTS_PITCH=-6Hz

# --- Прочее ---
OPENAI_API_KEY=
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
JARVIS_LOG_LEVEL=INFO
